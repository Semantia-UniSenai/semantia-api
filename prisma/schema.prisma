generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoomMemberRole {
  MODERATOR
  PARTICIPANT
}

enum ParticipantRole {
  HOST
  MODERATOR
  PARTICIPANT
  GUEST
}

enum SessionStatus {
  PREPARING
  LIVE
  ENDED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scores          Score[]
  hostedRooms     Room[]       @relation("RoomHost")
  roomMemberships RoomMember[]

  @@map("users")
}

model Score {
  id         String   @id @default(cuid())
  gameKey    String
  points     Int
  accuracy   Float?
  durationMs Int?
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameKey, points])
  @@map("scores")
}

model Room {
  id         String   @id @default(cuid())
  name       String
  hostId     String
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  host     User          @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  members  RoomMember[]
  sessions RoomSession[]

  @@index([hostId, createdAt])
  @@map("rooms")
}

model RoomMember {
  id       String         @id @default(cuid())
  roomId   String
  userId   String
  role     RoomMemberRole @default(PARTICIPANT)
  joinedAt DateTime       @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId, joinedAt])
  @@map("room_members")
}

model RoomSession {
  id               String        @id @default(cuid())
  title            String
  roomId           String
  joinToken        String        @unique
  status           SessionStatus @default(PREPARING)
  requiresApproval Boolean       @default(false)
  audienceContext  Json?
  createdAt        DateTime      @default(now())
  startedAt        DateTime?
  endedAt          DateTime?

  room       Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  transcripts TranscriptSegment[]
  messages    ChatMessage[]

  @@index([roomId, createdAt])
  @@map("room_sessions")
}

model TranscriptSegment {
  id              String   @id @default(cuid())
  sessionId       String
  clientSegmentId String
  seq             Int
  text            String
  createdAt       DateTime @default(now())

  session RoomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
  @@unique([sessionId, clientSegmentId])
  @@index([sessionId, seq])
  @@map("transcript_segments")
}

model ChatMessage {
  id              String          @id @default(cuid())
  sessionId       String
  participantId   String
  participantName String
  participantRole ParticipantRole
  text            String
  createdAt       DateTime        @default(now())

  session RoomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}
