# PostgreSQL connection string (used by Prisma CLI + runtime pg adapter).
# Local docker-compose default below; on Render this is provided by the DB add-on.
DATABASE_URL="postgresql://semantia:semantia@localhost:5432/semantia?schema=public"

# Secret used to sign JWTs (tokens expire in 7 days). Use a long random value in prod.
JWT_SECRET="change-me-to-a-long-random-secret"

# Allowed CORS origin. "*" for local dev; set to the frontend URL in production.
CORS_ORIGIN="*"

# HTTP port (Render injects PORT automatically).
PORT=3000
