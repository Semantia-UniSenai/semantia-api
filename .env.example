# PostgreSQL connection string (used by Prisma CLI + runtime pg adapter).
# Local docker-compose default below; on Render this is provided by the DB add-on.
DATABASE_URL="postgresql://semantia:semantia@localhost:5432/semantia?schema=public"

# Secret used to sign JWTs (tokens expire in 7 days). Use a long random value in prod.
JWT_SECRET="change-me-to-a-long-random-secret"

# Allowed CORS origin. "*" for local dev; set to the frontend URL in production.
CORS_ORIGIN="*"

# Backend ASR. Audio is ephemeral; only the final text is persisted.
ASR_URL="http://127.0.0.1:8000"
ASR_TIMEOUT_MS=45000

# LiveKit conferencing media. Secret values exist only in the API environment.
LIVEKIT_URL="wss://seu-projeto.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
# Limited internally to at most 600 seconds.
LIVEKIT_TOKEN_TTL_SECONDS=600
# Limited internally to at most 10 seconds.
LIVEKIT_REQUEST_TIMEOUT_SECONDS=5

# Derived pt-BR transcript adaptation. Disabled by default; literal remains canonical.
TRANSCRIPT_ADAPTATION_ENABLED=false
TRANSCRIPT_ADAPTATION_PROVIDER=disabled
TRANSCRIPT_ADAPTATION_MODEL=openai/gpt-oss-20b
TRANSCRIPT_ADAPTATION_PROMPT_VERSION=pt-br-accessible-v1
TRANSCRIPT_ADAPTATION_TIMEOUT_MS=2500
TRANSCRIPT_ADAPTATION_MAX_RETRIES=1
TRANSCRIPT_ADAPTATION_MAX_CONCURRENCY=2
TRANSCRIPT_ADAPTATION_MAX_QUEUE=32
TRANSCRIPT_ADAPTATION_CIRCUIT_FAILURE_THRESHOLD=5
TRANSCRIPT_ADAPTATION_CIRCUIT_RESET_MS=30000
TRANSCRIPT_ADAPTATION_TEMPERATURE=0.1
TRANSCRIPT_ADAPTATION_MAX_OUTPUT_TOKENS=512
# Backend secret. Keep empty in versioned files; configure only in env/secret manager.
GROQ_API_KEY=

# Optional host ports for Docker Compose dependencies.
POSTGRES_PORT=5432
ASR_PORT=8000
ASR_CPUS=2
ASR_MEMORY_LIMIT=3g

# HTTP port (Render injects PORT automatically).
PORT=3000
